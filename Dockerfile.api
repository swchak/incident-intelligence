FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY generator_spec ./generator_spec
COPY README.md ./
RUN pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "incident_intelligence.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
